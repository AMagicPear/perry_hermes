# Environment variables for Perry Hermes
#
# Cross-platform setup:
# 1. Copy this file to .env
# 2. Fill in your real values
# 3. The .env file is automatically loaded by the application

# MiniMax API key
MINIMAX_API_KEY=sk-...

# MIMO API key
MIMO_API_KEY=sk-...

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# QQ Bot credentials (from QQ Open Platform)
QQ_BOT_APP_ID=your_app_id
QQ_BOT_APP_SECRET=your_app_secret

# Optional: QQ Bot sandbox mode
# QQ_BOT_SANDBOX=true

# Optional: Proxy settings (if needed)
# On macOS/Linux, route through local proxy if Telegram is blocked
# https_proxy=http://127.0.0.1:7890
# http_proxy=http://127.0.0.1:7890
# all_proxy=socks5://127.0.0.1:7890

# Optional: Telegram allowed users (comma-separated user IDs)
# TELEGRAM_ALLOWED_USERS=123456789,987654321